;; kenchi-clj — provenance-gated, multi-source real-estate valuation library.
;; Coordinate: io.github.kotoba-lang/kenchi  · public API: kenchi.core
{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). The pure core
 ;; (kenchi.core/fusion/governor) needs neither; langgraph-clj is for the
 ;; optional actor (kenchi.parcel). Same runtime the robotaxi-actor sits on.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json {:git/sha "9c11ad189e64907700e8b4eb9b26f40336bffa01"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
                                     :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain-clj to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  ;; kbb -M:dev:run  → value one parcel through three scenarios (mock feeds)
  :run {:main-opts ["-m" "kenchi.sim"]}
  ;; kbb -M:dev:live → full live-wiring pipeline offline: real adapters
  ;; (fixtures) → fuse/govern → PDS putRecord (dry-run) → flywheel recalibration.
  ;; `valuation` on the classpath so ingest fixtures resolve via io/resource.
  :live {:extra-paths ["valuation"]
         :main-opts ["-m" "kenchi.live"]}
  ;; kbb -M:live-real ["POSTCODE"] → REAL network call to HM Land Registry
  ;; via kenchi.http (java.net.http + data.json) through the live ingest adapter.
  :live-real {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
              :main-opts ["-m" "kenchi.live-real"]}
  ;; kbb -M:cc-real ["URL-PATTERN" LIMIT] → REAL Common Crawl pull of
  ;; property asking prices (CC index → WARC range-fetch → price extract).
  :cc-real {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
            :main-opts ["-m" "kenchi.cc-real"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}