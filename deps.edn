;; kenchi-clj — provenance-gated, multi-source real-estate valuation library.
;; Coordinate: io.github.kotoba-lang/kenchi  · public API: kenchi.core
{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). The pure core
 ;; (kenchi.core/fusion/governor) needs neither; langgraph-clj is for the
 ;; optional actor (kenchi.parcel). Same runtime the robotaxi-actor sits on.
 :deps {io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
                                     :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain-clj to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  ;; clojure -M:dev:run  → value one parcel through three scenarios (mock feeds)
  :run {:main-opts ["-m" "kenchi.sim"]}
  ;; clojure -M:dev:live → full live-wiring pipeline offline: real adapters
  ;; (fixtures) → fuse/govern → PDS putRecord (dry-run) → flywheel recalibration.
  ;; `valuation` on the classpath so ingest fixtures resolve via io/resource.
  :live {:extra-paths ["valuation"]
         :main-opts ["-m" "kenchi.live"]}
  ;; clojure -M:live-real ["POSTCODE"] → REAL network call to HM Land Registry
  ;; via kenchi.http (java.net.http + data.json) through the live ingest adapter.
  :live-real {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
              :main-opts ["-m" "kenchi.live-real"]}
  ;; clojure -M:cc-real ["URL-PATTERN" LIMIT] → REAL Common Crawl pull of
  ;; property asking prices (CC index → WARC range-fetch → price extract).
  :cc-real {:extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}
            :main-opts ["-m" "kenchi.cc-real"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}